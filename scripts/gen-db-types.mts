/**
 * Generates src/lib/supabase/database.types.ts from the SQL migrations by
 * loading them into PGlite and introspecting the catalog. Output matches the
 * shape produced by `supabase gen types typescript`, so the file can later be
 * regenerated with the official CLI against a live project instead.
 *
 *   npm run db:types
 */
import { writeFileSync } from "node:fs";
import { join } from "node:path";
import { createTestDb } from "../tests/db/harness.ts";

const db = await createTestDb();

type Col = {
  table_name: string;
  column_name: string;
  is_nullable: "YES" | "NO";
  column_default: string | null;
  data_type: string;
  udt_name: string;
  is_identity: "YES" | "NO";
};

const tables = (
  await db.query<{ table_name: string }>(
    `select table_name from information_schema.tables
     where table_schema = 'public' and table_type = 'BASE TABLE' order by table_name`,
  )
).rows.map((r) => r.table_name);

const cols = (
  await db.query<Col>(
    `select table_name, column_name, is_nullable, column_default, data_type, udt_name, is_identity
     from information_schema.columns where table_schema = 'public' order by table_name, ordinal_position`,
  )
).rows;

const enums = (
  await db.query<{ name: string; values: string[] }>(
    `select t.typname as name, array_agg(e.enumlabel order by e.enumsortorder) as values
     from pg_type t join pg_enum e on e.enumtypid = t.oid
     join pg_namespace n on n.oid = t.typnamespace
     where n.nspname = 'public' group by t.typname order by t.typname`,
  )
).rows;
const enumNames = new Set(enums.map((e) => e.name));

const fks = (
  await db.query<{ table_name: string; name: string; columns: string[]; ref_table: string; ref_columns: string[]; one_to_one: boolean }>(
    `select c.conrelid::regclass::text as table_name, c.conname as name,
            array(select a.attname from unnest(c.conkey) with ordinality k(n, i)
                  join pg_attribute a on a.attrelid = c.conrelid and a.attnum = k.n order by k.i) as columns,
            c.confrelid::regclass::text as ref_table,
            array(select a.attname from unnest(c.confkey) with ordinality k(n, i)
                  join pg_attribute a on a.attrelid = c.confrelid and a.attnum = k.n order by k.i) as ref_columns,
            exists (select 1 from pg_constraint u where u.conrelid = c.conrelid and u.contype in ('p','u')
                    and u.conkey::int[] @> c.conkey::int[] and u.conkey::int[] <@ c.conkey::int[]) as one_to_one
     from pg_constraint c
     join pg_namespace n on n.oid = c.connamespace
     where c.contype = 'f' and n.nspname = 'public' order by c.conname`,
  )
).rows;

const fns = (
  await db.query<{ name: string; args: string | null; result: string }>(
    `select p.proname as name,
            pg_get_function_arguments(p.oid) as args,
            pg_get_function_result(p.oid) as result
     from pg_proc p join pg_namespace n on n.oid = p.pronamespace
     where n.nspname = 'public' and p.prorettype <> 'trigger'::regtype order by p.proname`,
  )
).rows;

function tsType(dataType: string, udt: string): string {
  if (dataType === "ARRAY") return `${tsType(udt.replace(/^_/, ""), udt.replace(/^_/, ""))}[]`;
  if (dataType === "USER-DEFINED" || enumNames.has(udt)) return `Database["public"]["Enums"]["${udt}"]`;
  switch (udt) {
    case "int2":
    case "int4":
    case "int8":
    case "float4":
    case "float8":
    case "numeric":
    case "smallint":
    case "integer":
    case "bigint":
      return "number";
    case "bool":
    case "boolean":
      return "boolean";
    case "json":
    case "jsonb":
      return "Json";
    default:
      return "string";
  }
}

function pgArgType(t: string): string {
  t = t.trim();
  if (/^(integer|bigint|smallint|numeric|real|double precision)$/.test(t)) return "number";
  if (t === "boolean") return "boolean";
  if (t === "jsonb" || t === "json") return "Json";
  return "string";
}

const lines: string[] = [];
lines.push(`// AUTO-GENERATED by scripts/gen-db-types.mts from supabase/migrations. Do not edit by hand.`);
lines.push(`export type Json = string | number | boolean | null | { [key: string]: Json | undefined } | Json[];`);
lines.push(``);
lines.push(`export type Database = {`);
lines.push(`  public: {`);
lines.push(`    Tables: {`);
for (const t of tables) {
  const tc = cols.filter((c) => c.table_name === t);
  const row = tc.map((c) => `          ${c.column_name}: ${tsType(c.data_type, c.udt_name)}${c.is_nullable === "YES" ? " | null" : ""};`);
  const ins = tc.map((c) => {
    const optional = c.is_nullable === "YES" || c.column_default !== null || c.is_identity === "YES";
    return `          ${c.column_name}${optional ? "?" : ""}: ${tsType(c.data_type, c.udt_name)}${c.is_nullable === "YES" ? " | null" : ""};`;
  });
  const upd = tc.map((c) => `          ${c.column_name}?: ${tsType(c.data_type, c.udt_name)}${c.is_nullable === "YES" ? " | null" : ""};`);
  const rel = fks
    .filter((f) => f.table_name.replace(/^public\./, "") === t && !f.ref_table.includes("."))
    .map(
      (f) =>
        `          { foreignKeyName: "${f.name}"; columns: [${f.columns.map((c) => `"${c}"`).join(", ")}]; isOneToOne: ${f.one_to_one}; referencedRelation: "${f.ref_table}"; referencedColumns: [${f.ref_columns.map((c) => `"${c}"`).join(", ")}] },`,
    );
  lines.push(`      ${t}: {`);
  lines.push(`        Row: {`, ...row, `        };`);
  lines.push(`        Insert: {`, ...ins, `        };`);
  lines.push(`        Update: {`, ...upd, `        };`);
  lines.push(`        Relationships: [`, ...rel, `        ];`);
  lines.push(`      };`);
}
lines.push(`    };`);
lines.push(`    Views: { [_ in never]: never };`);
lines.push(`    Functions: {`);
for (const f of fns) {
  const args = (f.args ?? "")
    .split(",")
    .map((a) => a.trim())
    .filter(Boolean)
    .map((a) => {
      const [name, ...type] = a.replace(/ DEFAULT .*/i, "").split(/\s+/);
      return `${name}: ${pgArgType(type.join(" "))}`;
    });
  lines.push(`      ${f.name}: { Args: { ${args.join("; ")} }; Returns: ${pgArgType(f.result)} };`);
}
lines.push(`    };`);
lines.push(`    Enums: {`);
for (const e of enums) lines.push(`      ${e.name}: ${e.values.map((v) => `"${v}"`).join(" | ")};`);
lines.push(`    };`);
lines.push(`    CompositeTypes: { [_ in never]: never };`);
lines.push(`  };`);
lines.push(`};`);
lines.push(``);
lines.push(`type PublicSchema = Database["public"];`);
lines.push(`export type Tables<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Row"];`);
lines.push(`export type TablesInsert<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Insert"];`);
lines.push(`export type TablesUpdate<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Update"];`);
lines.push(`export type Enums<T extends keyof PublicSchema["Enums"]> = PublicSchema["Enums"][T];`);
lines.push(``);

const out = join(process.cwd(), "src", "lib", "supabase", "database.types.ts");
writeFileSync(out, lines.join("\n"));
console.log(`Wrote ${out} (${tables.length} tables, ${fns.length} functions, ${enums.length} enums)`);
await db.close();
